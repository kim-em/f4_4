default(parisize, "2G");
\\ fields: z = zeta13, theta generates E, eta = z + 1/z generates k
z = Mod(y, polcyclo(13, y));
th = z + z^5 + z^8 + z^12;
Epol = subst(minpoly(th), 'x, 't);
print("E: minimal polynomial of theta: ", Epol, "  disc ", factor(poldisc(Epol)));
nfE = nfinit(Epol);
facs = nffactor(nfE, polcyclo(13, 'x))[,1];
f = 0; for(i = 1, #facs, if(lift(lift(Mod(Mod(1, nfE.pol) * ('x + 'x^5 + 'x^8 + 'x^12), facs[i]))) == 't, f = facs[i]));
if(f == 0, error("no factor matching theta"));
print("Q(zeta13) = E[x]/f, f = ", f);
rnf = rnfinit(nfE, f);
s = Mod('x^5, f);   \\ s: zeta13 -> zeta13^5, a generator of Gal(Q(zeta13)/E), s^2 = complex conjugation
Tn = rnfisnorminit(Epol, f, 1);
vc(v) = my(p = lift(v)); Col(vector(12, i, polcoef(p, i - 1, 'y)));
M3 = Mat([vc(th^0), vc(th), vc(th^2)]);
toE(v) = my(c = matinverseimage(M3, vc(v))); if(#c == 0 || Mod(1, polcyclo(13, y)) * (c[1] + c[2] * th + c[3] * th^2) != v, error("not in E")); c[1] + c[2] * 't + c[3] * 't^2;
rE = polroots(Epol);
\\ k = Q(eta), eta = z + 1/z
et = z + z^12; kpol = subst(minpoly(et), 'x, 'v); nfk = nfinit(kpol);
M6 = matconcat(vector(6, i, vc(et^(i - 1))));
tok(v) = my(c = matinverseimage(M6, vc(v))); if(#c == 0 || Mod(1, polcyclo(13, y)) * sum(i = 1, 6, c[i] * et^(i - 1)) != v, error("not in k")); sum(i = 1, 6, c[i] * 'v^(i - 1));
dk = 'v^2 - 4;  \\ k(sqrt(dk)) = Q(zeta13)
print("k: ", kpol, ";  d = eta^2 - 4, totally negative: ", vecmax(apply(r -> real(r)^2 - 4, polroots(kpol))) < 0);
print("\n== j = 1: Psi_1 = (s, pi^1, c_1); braided: False");
uz = ((4240427728)*(z^1 + z^12) + (2375594032)*(z^2 + z^11) + (2375594032)*(z^3 + z^10) + (1672173440)*(z^4 + z^9) + (4240427728)*(z^5 + z^8) + (1672173440)*(z^6 + z^7));
b = toE(uz); den = denominator(content(b)); bi = b * den^4;
print("u_0002 = ", b, "  in E;  (integral multiple by d^4, d = ", den, ")");
print("  signs at the real places of E: ", vector(3, i, sign(real(subst(b, 't, rE[i])))));
fa = idealfactor(nfE, bi); print("  factorisation of the integral multiple: ", vector(#fa~, i, [fa[i,1].p, fa[i,1].f, fa[i,1].e, fa[i,2], if(fa[i,1].p == 13, "ramified", znorder(Mod(fa[i,1].p, 13)) / fa[i,1].f)]));
print("  (columns: p, f, e of the prime of E, exponent, local degree of Q(zeta13)/E at the prime (p != 13: unramified, degree = ord_13(p)/f))");
nr = rnfisnorm(Tn, Mod(bi, Epol));
isnorm = (nr[2] == 1);
if(isnorm, al = Mod(lift(nr[1]), f); chk = Mod(1, f) * al * subst(lift(al), 'x, 'x^5) * subst(lift(al), 'x, 'x^25) * subst(lift(al), 'x, 'x^125); print("  u is a norm from Q(zeta13): exact check N(a) = u: ", chk == Mod(bi, f)), print("  u is not a norm from Q(zeta13) (rnfisnorm, flag 1: guaranteed for Galois extensions given the bnf)"));
A = alginit(rnf, [s, bi]);
print("  cyclic algebra (Q(zeta13)/E, s, u_0002): Hasse invariants at the real places ", alghassei(A), ", at finite places ", alghassef(A), ", index ", algindex(A));
pr = alghassef(A)[1]; if(#pr, print("    finite places: ", vector(#pr, i, [pr[i].p, pr[i].f, pr[i].e])));
bk = tok(uz);
print("  real embeddings of E agree with the ordering of nfE.roots: ", vector(3,i,real(nfE.roots[i])), " vs ", vector(3,i,real(rE[i])));
Q = alginit(nfk, [dk, bk * denominator(content(bk))^2]);
print("  quaternion algebra (eta^2-4, u_0002)_k: Hasse invariants real ", alghassei(Q), ", finite ", alghassef(Q)[2], ", split: ", algissplit(Q));
bk1_0002 = bk;
